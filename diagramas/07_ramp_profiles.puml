@startuml Ramp Profiles
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontSize 12

title Perfiles de Aceleración - Implementación Pendiente

start

:Calculate total distance to move;

if (distance_total > dist_accel + dist_decel?) then (yes)
  :TRAPEZOIDAL Profile;
  partition "Trapezoidal Ramp" {
    :Phase 1: ACCELERATION;
    note right
      Gradually increase NCO frequency
      from start to max_speed
      (velocity ramps up)
    end note
    
    :Phase 2: CONSTANT SPEED;
    note right
      Maintain maximum velocity
      for middle portion of move
      (flat top of trapezoid)
    end note
    
    :Phase 3: DECELERATION;
    note right
      Gradually decrease NCO frequency
      from max_speed to zero
      (velocity ramps down)
    end note
  }
else (no)
  :TRIANGULAR Profile;
  partition "Triangular Ramp" {
    :Phase 1: ACCELERATION;
    note right
      Increase NCO frequency
      until reaching peak velocity
      (peak < max_speed)
    end note
    
    :Phase 2: IMMEDIATE DECELERATION;
    note right
      No constant speed phase
      Immediately decelerate
      after reaching peak
    end note
  }
endif

stop

